# ===== Mini Coding Agent 配置 =====
# 填上公司提供的 API Key 后重启服务即可切换为真实模型；
# 不填则自动进入 Mock 模式（规则模拟，用于演示完整链路）。

# OpenAI 兼容 API Key
OPENAI_API_KEY=

# OpenAI 兼容 API Base URL（DeepSeek 默认；其它厂商按需改）
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 模型名
OPENAI_MODEL=deepseek-chat

# 服务端口
PORT=8000

# shell 命令超时（秒）
CMD_TIMEOUT=60
